{
  "name": "favorites-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Favorites - Media Tracking & Discovery Platform Monorepo Orchestrator",
  "workspaces": [
    "frontend",
    "workers",
    "api"
  ],
  "scripts": {
    "dev": "bun run docker:up",
    "dev:all": "docker compose up --build -d",
    "dev:frontend": "cd frontend && bun dev",
    "dev:api": "dotnet watch run --project api/src/Favorites.Api/Favorites.Api.csproj",
    "dev:api:docker": "docker build -t favorites-api -f api/Dockerfile api/ && docker run --name favorites-api-dev -p 5000:8080 --rm -e ENABLE_SWAGGER=true favorites-api",
    "dev:workers": "cd workers && bun dev",
    "build": "bun run build:frontend",
    "build:frontend": "cd frontend && bun run build",
    "build:api": "docker build -t favorites-api -f api/Dockerfile api/",
    "build:workers": "cd workers && bun run build",
    "lint": "bun run lint:frontend",
    "lint:frontend": "cd frontend && bun run lint",
    "test": "bun run test:frontend",
    "test:frontend": "cd frontend && bun run test",
    "test:api": "docker build -t favorites-api-test -f api/Dockerfile api/",
    "test:workers": "cd workers && bun test",
    "docker:up": "docker compose up --build -d",
    "docker:up:all": "docker compose up --build -d",
    "docker:up:api": "docker compose up --build -d postgres miniflare api",
    "docker:up:frontend": "docker compose up --build -d frontend",
    "docker:up:db": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "docker:down:v": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:logs:api": "docker compose logs -f api",
    "docker:logs:frontend": "docker compose logs -f frontend",
    "docker:clean": "docker compose down -v --remove-orphans"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.0.0"
  }
}
