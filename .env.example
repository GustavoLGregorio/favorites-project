# Monorepo Global Environment Configuration Template

# Database Configuration (PostgreSQL 18 / Neon)
DB_CONNECTION_STRING="postgresql://username:password@ep-host.region.aws.neon.tech/dbname?sslmode=require"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="favorites_db"
POSTGRES_PORT=5432

# Google OAuth 2.0 Identity Provider
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Core API (.NET 10 Web API)
API_PORT=5000
JWT_SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_AT_LEAST_32_BYTES"
JWT_ISSUER="FavoritesApi"
JWT_AUDIENCE="FavoritesClient"
JWT_EXPIRATION_MINUTES=1440

# Frontend Web Application (Next.js 16)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
NEXT_PUBLIC_WORKERS_URL="http://localhost:8787"

# Edge Layer & Workers (Cloudflare Workers / Miniflare)
WORKERS_PORT=8787
WORKERS_SECRET_KEY="FAVORITES_WORKER_SECRET_TOKEN"
TMDB_API_KEY="YOUR_TMDB_API_KEY"
IGDB_CLIENT_ID="YOUR_IGDB_CLIENT_ID"
IGDB_CLIENT_SECRET="YOUR_IGDB_CLIENT_SECRET"
