# Core API Environment Configuration Template (.NET 10 Web API)

# Database Connection String (PostgreSQL 18 / Neon)
ConnectionStrings__DefaultConnection="Host=localhost;Database=favorites;Username=postgres;Password=postgres"

# Google OAuth 2.0 Identity Provider Settings
Authentication__Google__ClientId="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
Authentication__Google__ClientSecret="YOUR_GOOGLE_CLIENT_SECRET"

# JWT Authentication Settings
Jwt__SecretKey="SUPER_SECRET_FALLBACK_KEY_AT_LEAST_32_BYTES_LONG_FAVORITES_API"
Jwt__Issuer="FavoritesApi"
Jwt__Audience="FavoritesClient"
Jwt__ExpirationMinutes="1440"
